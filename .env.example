# Supabase PostgreSQL Pooled Connection (used for queries via PgBouncer on port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase PostgreSQL Direct Connection (used for migrations and schema sync on port 5432)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Cryptographic Session Secret (used for signing session tokens; min 32 chars)
SESSION_SECRET="your-ultra-secure-random-32-character-secret-key-here"
